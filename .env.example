# 服务器配置
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# 数据库配置
MONGO_URI=mongodb://localhost:27017/xiaoshijie

# JWT配置
JWT_SECRET=your-secret-key-change-this
JWT_EXPIRES_IN=7d

# 默认管理员
DEFAULT_ADMIN_EMAIL=admin@xiaoshijie.com
DEFAULT_ADMIN_PASSWORD=Admin@123
ADMIN_INIT_KEY=xiaoshijie-secret-init-key

# 文件存储路径
AVATAR_PATH=uploads/avatars
QRCODE_PATH=uploads/qrcodes
ARTICLE_PATH=uploads/articles
VIDEO_PATH=uploads/videos
MAX_FILE_SIZE=5242880 # 5MB 